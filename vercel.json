{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/waitlist.html", "destination": "/waitlist", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/careers.html", "destination": "/careers", "permanent": true },
    { "source": "/blog.html", "destination": "/blog", "permanent": true },
    { "source": "/blog/competitor-analysis.html", "destination": "/blog/competitor-analysis", "permanent": true },
    { "source": "/methodology.html", "destination": "/methodology", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/manifesto.html", "destination": "/manifesto", "permanent": true },
    { "source": "/security.html", "destination": "/security", "permanent": true },
    { "source": "/status.html", "destination": "/status", "permanent": true },
    { "source": "/specimen.html", "destination": "/specimen", "permanent": true },
    { "source": "/pricing.html", "destination": "/pricing", "permanent": true },
    { "source": "/onboarding.html", "destination": "/onboarding", "permanent": true },
    { "source": "/advisor.html", "destination": "/four", "permanent": true },
    { "source": "/advisor", "destination": "/four", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/signup.html", "destination": "/signup", "permanent": true },
    { "source": "/reset.html", "destination": "/reset", "permanent": true },
    { "source": "/four.html", "destination": "/four", "permanent": true }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/waitlist", "destination": "/waitlist.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/competitor-analysis", "destination": "/blog/competitor-analysis.html" },
    { "source": "/methodology", "destination": "/methodology.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/manifesto", "destination": "/manifesto.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/status", "destination": "/status.html" },
    { "source": "/specimen", "destination": "/specimen.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/reset", "destination": "/reset.html" },
    { "source": "/four", "destination": "/four.html" }
  ],
  "functions": {
    "api/advise.js": { "maxDuration": 60 },
    "api/daily-briefs.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/d/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/deliverables/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
